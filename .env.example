# ============================================================================
# commerce-orchestrator 环境变量模板 —— 变量名的单一事实来源
# backend 的 config.py 通过 COMMERCE_ 前缀读取应用配置；
# POSTGRES_* 仅供 Docker Compose 插值使用（应用进程不读取）。
#
# 用法：
#   Linux/macOS:  cp .env.example .env
#   Windows:      Copy-Item .env.example .env
#   （.env 已被 .gitignore 忽略，切勿把真实密钥提交到仓库）
#
# 安全提醒：本文件只允许占位符/示例值。
# ============================================================================

# ---------------------------------------------------------------------------
# 数据库连接（本地裸机开发使用 localhost；
# docker compose 会在容器内用 environment 覆盖为 postgres 服务名）
# ---------------------------------------------------------------------------
# 应用主库（SQLAlchemy，psycopg 3 驱动）
COMMERCE_DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/commerce
# DBOS 系统库（工作流/队列/幂等元数据；由 infra/postgres/init.sql 创建）
COMMERCE_DBOS_SYSTEM_DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/dbos

# ---------------------------------------------------------------------------
# 认证与加密
# ---------------------------------------------------------------------------
# JWT 签名密钥。生产环境必须替换为强随机串，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
COMMERCE_JWT_SECRET=change-me-to-a-long-random-string
# JWT 有效期（分钟），480 = 8 小时
COMMERCE_JWT_EXPIRES_MINUTES=480
# Fernet 对称加密密钥（用于敏感字段加密）。生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 必填项；占位符会导致运行时加解密失败。
COMMERCE_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# ---------------------------------------------------------------------------
# 运行环境与日志
# ---------------------------------------------------------------------------
# dev | staging | prod（影响日志格式、调试开关、CORS 等）
COMMERCE_ENVIRONMENT=dev
# DEBUG / INFO / WARNING / ERROR
COMMERCE_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Shopify（dev store 连接；Admin API + webhook 验签）
# ---------------------------------------------------------------------------
# Shopify API 日历版本，如 2026-07
COMMERCE_SHOPIFY_API_VERSION=2026-07
# 店铺名（如 my-store.myshopify.com 中的 my-store）
COMMERCE_SHOPIFY_SHOP_NAME=
# Admin API 访问令牌（敏感，勿提交）
COMMERCE_SHOPIFY_ACCESS_TOKEN=
# Webhook 签名校验密钥（敏感，勿提交）
COMMERCE_SHOPIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Odoo 19（JSON-2 API：POST /json/2/<model>/<method> + Bearer API key）
# ---------------------------------------------------------------------------
COMMERCE_ODOO_BASE_URL=
COMMERCE_ODOO_API_KEY=
COMMERCE_ODOO_DB=
COMMERCE_ODOO_USERNAME=
# ODOO_ADMIN_PASSWORD=admin  # 仅 P0/开发：odoo19 profile 容器管理员口令（compose 插值，正式环境禁用）

# ---------------------------------------------------------------------------
# 可观测性
# ---------------------------------------------------------------------------
# OTLP 端点（http(s)://host:4318）；留空表示不启用 OTLP 导出
COMMERCE_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# 数据治理
# ---------------------------------------------------------------------------
# 原始 webhook / 回调负载的保留天数（到期清理）
COMMERCE_RAW_PAYLOAD_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# DBOS 运行时（可选；仅当 backend 需要从环境变量初始化 DBOS 时启用）
# backend 的 DBOS 初始化代码是权威来源，这里只做提示：
# ---------------------------------------------------------------------------
# DBOS__DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/dbos

# ---------------------------------------------------------------------------
# Docker Compose 专用（仅 compose.yaml 插值使用，应用进程不读取）
# v1 固定默认值 commerce/commerce/commerce；如需修改，必须同步修改：
#   1) 上面两个 COMMERCE_*_DATABASE_URL
#   2) compose.yaml 中 metabase（MB_DB_*）与 odoo19（USER/PASSWORD/NAME）配置
# ---------------------------------------------------------------------------
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce
POSTGRES_DB=commerce

# Metabase 应用库名（compose.yaml 中 MB_DB_DBNAME 固定为 metabase；
# 该库由 infra/postgres/init.sql 自动创建，一般无需改动）
# METABASE_DB_NAME=metabase
