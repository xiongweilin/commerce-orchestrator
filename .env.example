# ============================================================================
# commerce-orchestrator 环境变量模板 —— 变量名的单一事实来源
# backend 的 config.py 通过 COMMERCE_ 前缀读取应用配置；
# POSTGRES_* 仅供 Docker Compose 插值使用（应用进程不读取）。
#
# 用法：
#   Linux/macOS:  cp .env.example .env
#   Windows:      Copy-Item .env.example .env
#   （.env 已被 .gitignore 忽略，切勿把真实密钥提交到仓库）
#
# 安全提醒：本文件只允许占位符/示例值。
# ============================================================================

# ---------------------------------------------------------------------------
# 数据库连接（本地裸机开发使用 localhost；
# docker compose 会在容器内用 environment 覆盖为 postgres 服务名）
# ---------------------------------------------------------------------------
# 应用主库（SQLAlchemy，psycopg 3 驱动）
COMMERCE_DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/commerce
# DBOS 系统库（工作流/队列/幂等元数据；由 infra/postgres/init.sql 创建）
COMMERCE_DBOS_SYSTEM_DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/dbos

# ---------------------------------------------------------------------------
# 数据库最小权限角色连接（P7 整改：API 与 worker 使用不同 URL/角色）
# 本地裸机开发使用 localhost；docker compose 会在容器内覆盖为 postgres 服务名。
# 角色与口令由 infra/postgres/bootstrap.sql 幂等创建（开发占位符，禁止用于生产）。
# ---------------------------------------------------------------------------
# API 角色（commerce_api：command/webhook/decision 及读取；WP4 config.py 落地字段）
COMMERCE_API_DATABASE_URL=postgresql+psycopg://commerce_api:commerce_api@localhost:5432/commerce
# Worker 角色（commerce_worker：workflow/domain/effect/reconciliation 写权限）
COMMERCE_WORKER_DATABASE_URL=postgresql+psycopg://commerce_worker:commerce_worker@localhost:5432/commerce

# ---------------------------------------------------------------------------
# inbox relay / effect 重试（WP4 config.py 落地字段）
# ---------------------------------------------------------------------------
# worker 轮询间隔（毫秒），默认 500
COMMERCE_INBOX_POLL_INTERVAL_MS=500
# 每批认领数量，默认 50
COMMERCE_INBOX_BATCH_SIZE=50
# 认领 lease 时长（秒），默认 30
COMMERCE_INBOX_LEASE_SECONDS=30
# 单条 inbox 最大尝试次数，超过进入 failed，默认 10
COMMERCE_INBOX_MAX_ATTEMPTS=10
# effect 可重试最大次数，默认 3
COMMERCE_EFFECT_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# 隐私（P7：需要匹配但无需还原的 customer ref 用独立 HMAC key，不直接加密还原）
# ---------------------------------------------------------------------------
# HMAC 密钥（敏感，勿提交；生成：python -c "import secrets; print(secrets.token_urlsafe(32))"）
COMMERCE_PII_HASH_KEY=

# ---------------------------------------------------------------------------
# 控制台（Next.js BFF 安全会话；WP2 落地）
# ---------------------------------------------------------------------------
# CSRF/Origin 校验用的控制台源（与 compose 宿主端口一致）
COMMERCE_CONSOLE_ORIGIN=http://localhost:3200

# ---------------------------------------------------------------------------
# 认证与加密
# ---------------------------------------------------------------------------
# JWT 签名密钥。生产环境必须替换为强随机串，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
COMMERCE_JWT_SECRET=change-me-to-a-long-random-string
# JWT 有效期（分钟），480 = 8 小时
COMMERCE_JWT_EXPIRES_MINUTES=480
# Fernet 对称加密密钥（用于敏感字段加密）。生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 必填项；占位符会导致运行时加解密失败。
COMMERCE_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# ---------------------------------------------------------------------------
# 运行环境与日志
# ---------------------------------------------------------------------------
# dev | staging | prod（影响日志格式、调试开关、CORS 等）
COMMERCE_ENVIRONMENT=dev
# DEBUG / INFO / WARNING / ERROR
COMMERCE_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Shopify（dev store 连接；Admin API + webhook 验签）
# ---------------------------------------------------------------------------
# Shopify API 日历版本，如 2026-07
COMMERCE_SHOPIFY_API_VERSION=2026-07
# 店铺名（如 my-store.myshopify.com 中的 my-store）
COMMERCE_SHOPIFY_SHOP_NAME=
# Admin API 访问令牌（敏感，勿提交）
COMMERCE_SHOPIFY_ACCESS_TOKEN=
# Dev Dashboard 应用 Client ID（client-credentials 模式，二选一于 ACCESS_TOKEN）
COMMERCE_SHOPIFY_CLIENT_ID=
# Dev Dashboard 应用 Client Secret（敏感，勿提交；同时用于 webhook HMAC 验签）
COMMERCE_SHOPIFY_CLIENT_SECRET=
# Webhook 签名校验密钥（敏感，勿提交）
COMMERCE_SHOPIFY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Odoo 19（JSON-2 API：POST /json/2/<model>/<method> + Bearer API key）
# ---------------------------------------------------------------------------
COMMERCE_ODOO_BASE_URL=
COMMERCE_ODOO_API_KEY=
COMMERCE_ODOO_DB=
COMMERCE_ODOO_USERNAME=
# ODOO_ADMIN_PASSWORD=admin  # 仅 P0/开发：odoo19 profile 容器管理员口令（compose 插值，正式环境禁用）

# ---------------------------------------------------------------------------
# Dify workflow LLM（P6 候选生成：LLM 只生成建议，不批准不执行）
# 本地部署：docker compose（nginx 暴露 18080），service API 走 /v1/workflows/<id>/run
# ---------------------------------------------------------------------------
# Dify 服务基础地址
COMMERCE_DIFY_BASE_URL=http://127.0.0.1:18080
# 已发布的 workflow id（控制台：应用 → API 访问 / 工作流详情）
COMMERCE_DIFY_WORKFLOW_ID=
# 应用 API 密钥（敏感，勿提交；控制台：应用 → API 访问 → API 密钥）
COMMERCE_DIFY_API_KEY=

# ---------------------------------------------------------------------------
# 可观测性
# ---------------------------------------------------------------------------
# OTLP 端点（http(s)://host:4318）；留空表示不启用 OTLP 导出
COMMERCE_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# 数据治理
# ---------------------------------------------------------------------------
# 原始 webhook / 回调负载的保留天数（到期清理）
COMMERCE_RAW_PAYLOAD_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# DBOS 运行时（可选；仅当 backend 需要从环境变量初始化 DBOS 时启用）
# backend 的 DBOS 初始化代码是权威来源，这里只做提示：
# ---------------------------------------------------------------------------
# DBOS__DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/dbos

# ---------------------------------------------------------------------------
# Docker Compose 专用（仅 compose.yaml 插值使用，应用进程不读取）
# v1 固定默认值 commerce/commerce/commerce；如需修改，必须同步修改：
#   1) 上面的 COMMERCE_*_DATABASE_URL（DATABASE_URL / DBOS_SYSTEM / API / WORKER）
#   2) compose.yaml 中 metabase（MB_DB_*）与 odoo19（USER/PASSWORD/NAME）配置
# P7 起业务库连接改用最小权限角色，占位口令与 infra/postgres/bootstrap.sql 一致：
#   commerce_migrator / commerce_api / commerce_worker / commerce_readonly /
#   dbos_app / metabase_app / odoo_app（全部为开发占位符，真实口令禁止入库）
# ---------------------------------------------------------------------------
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce
POSTGRES_DB=commerce

# 监控与前端宿主端口（可选覆盖；默认避开 Windows 系统保留段 3001-3100）
# API_PORT=8000
# CONSOLE_PORT=3200
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# ALERTMANAGER_PORT=9093
# ALERT_RECEIVER_PORT=9116
# METABASE_PORT=3201

# Grafana 管理员（开发占位；生产必须用 secret 注入强口令）
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=grafana

# Metabase 应用库连接（独立角色 metabase_app，非 owner/写账号）
# METABASE_DB_USER=metabase_app
# METABASE_DB_PASSWORD=metabase_app

# Odoo 库连接（独立角色 odoo_app）
# ODOO_DB_USER=odoo_app
# ODOO_DB_PASSWORD=odoo_app

# Metabase 应用库名（compose.yaml 中 MB_DB_DBNAME 固定为 metabase；
# 该库由 infra/postgres/init.sql 自动创建，一般无需改动）
# METABASE_DB_NAME=metabase
